# Backend API URL — used for server-side calls via apiFetch and as the
# proxy target for the same-origin /api/presence/ws rewrite (see next.config.ts).
API_URL=http://127.0.0.1:8000

# Public site URL — used for absolute URLs in metadata (OG, canonical, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recipient address for the contact form. The /contact page builds a
# `mailto:` to this address that opens the visitor's native mail client.
CONTACT_EMAIL=hello@learnic.dev

# Credentials used by Playwright e2e tests to drive auth-gated routes.
# Fill these in .env.local with a real test account — never commit real values.
TEST_LOGIN=test@example.com
TEST_PASSWORD=changeme
