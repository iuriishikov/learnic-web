# Backend API URL — used for server-side calls via apiFetch and as the
# proxy target for the same-origin /api/presence/ws rewrite (see next.config.ts).
# This localhost value is for `pnpm dev`. Container deploys do NOT rely on it:
# `just prod-up-colocated` sets API_URL=http://learnic-app:8000 automatically, and
# `just prod-up` (split) refuses to build unless you set a real API_URL here.
API_URL=http://127.0.0.1:8000

# Public site URL — used for absolute URLs in metadata (OG, canonical, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default UI theme on first visit (client-read, passed to next-themes).
# One of: system | light | dark. Leave as `system` to respect the visitor's
# OS preference (recommended); set light/dark only to force a theme on first paint.
NEXT_PUBLIC_DEFAULT_THEME=system

# Recipient address for the contact form. The /contact page builds a
# `mailto:` to this address that opens the visitor's native mail client.
CONTACT_EMAIL=hello@learnic.dev

# URL of the product's Telegram channel — the landing hero announcement
# chip links to it. Read on the server when rendering the home page.
TELEGRAM_CHANNEL_URL=https://t.me/learnic_ru

# Credentials used by Playwright e2e tests to drive auth-gated routes.
# Fill these in .env.local with a real test account — never commit real values.
TEST_LOGIN=test@example.com
TEST_PASSWORD=changeme

# ============================================================================
# Deployment (Docker Compose + Caddy)
# Only needed when self-hosting the container stack — NOT used by `pnpm dev`.
# See docker-compose.yaml and the justfile. `pnpm dev` keeps reading the
# dev values above from .env.local.
# ============================================================================

# API_URL per topology (the justfile recipes set/guard this for you):
#   co-located (one host): http://learnic-app:8000  — set automatically by `just prod-up-colocated`
#   split (two hosts)     : https://api.learnic.ru    — you set it in .env; `just prod-up` refuses localhost
# Split-mode note: the BACKEND must add THIS host's public IP to RATE_LIMIT_EXEMPT_IPS
# (in the backend .env), or this frontend's SSR / Server-Action traffic gets rate-limited.

# Public domain served by the frontend's own Caddy edge (split/standalone).
SITE_DOMAIN=learnic.ru

# Public domain of the backend API (used by the co-located edge's api block).
API_DOMAIN=api.learnic.ru

# Email for Let's Encrypt ACME registration (Caddy TLS certificates).
ACME_EMAIL=you@example.com

# Per-user throttle on the frontend edge (anti-scraping), per visitor IP. Static
# assets are excluded, so this counts real page/API requests. Raise EVENTS if
# legitimate users share a NAT/office IP.
SITE_RATE_LIMIT_EVENTS=300
SITE_RATE_LIMIT_WINDOW=1m
# Tight zone for auth-form submits only (POST to the login/register/forgot/reset
# pages). Throttles in-UI login brute force without affecting normal browsing.
SITE_AUTH_RATE_LIMIT_EVENTS=10
SITE_AUTH_RATE_LIMIT_WINDOW=1m
