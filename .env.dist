# Backend API URL — used for server-side calls via apiFetch and as the
# proxy target for the same-origin /api/presence/ws rewrite (see next.config.ts).
API_URL=http://127.0.0.1:8000

# Public site URL — used for absolute URLs in metadata (OG, canonical, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VAPID public key for Web Push subscriptions. The browser passes
# this to PushManager.subscribe as `applicationServerKey`. Matching
# private key (WEBPUSH_VAPID_PRIVATE_KEY) lives on the backend.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
